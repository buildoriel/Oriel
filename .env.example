# ======================================================================
# ORIEL — salin menjadi .env.local (dev) dan isi di Vercel (produksi)
# Variabel NEXT_PUBLIC_* terlihat di browser. Sisanya rahasia server.
# ======================================================================

# --- Aplikasi ---
NEXT_PUBLIC_APP_URL=https://buildoriel.com
NEXT_PUBLIC_ROOT_DOMAIN=buildoriel.com
SITES_CNAME_TARGET=sites.buildoriel.com
# Host preview draf (origin terpisah dari aplikasi). Dev: http://preview.localhost:3000
PREVIEW_ORIGIN=https://preview.buildoriel.com
# openssl rand -base64 32
PREVIEW_SIGNING_SECRET=
# Dipakai Vercel Cron (header Authorization: Bearer ...). openssl rand -hex 32
CRON_SECRET=

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Provider AI ---
# openrouter (default) atau anthropic
LLM_PROVIDER=openrouter
# openrouter.ai/keys
OPENROUTER_API_KEY=
# Provider yang boleh melayani model Claude. Tetap "anthropic" agar prompt cache kena.
OPENROUTER_PROVIDER_ORDER=anthropic
# Timpa slug model bila berbeda di openrouter.ai/models, mis.
# {"claude-sonnet-5-5":"anthropic/claude-sonnet-5.5"}
OPENROUTER_MODEL_MAP=
# Hanya dibutuhkan bila LLM_PROVIDER=anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Opsional: timpa harga per 1 juta token, mis.
# {"claude-sonnet-5-5":{"input":3,"output":15,"cacheWrite":3.75,"cacheRead":0.3}}
MODEL_PRICES_JSON=

# --- Robinhood Chain (mainnet, chain ID 4663) ---
# RPC server berisi API key provider (Alchemy). Hanya dipakai di server, tidak pernah ke browser.
RH_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
RH_CHAIN_ID=4663
RH_EXPLORER_URL=https://robinhoodchain.blockscout.com
# RPC untuk browser dan wallet user: pakai endpoint publik, JANGAN isi URL ber-API-key di sini
# (semua NEXT_PUBLIC_* terlihat siapa pun yang membuka situs).
NEXT_PUBLIC_RH_CHAIN_ID=4663
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RH_EXPLORER_URL=https://robinhoodchain.blockscout.com
PAYMENT_MIN_CONFIRMATIONS=3

# Token & alamat (isi setelah token $ORIEL diluncurkan di Pons dan kontrak di-deploy)
ORIEL_TOKEN_ADDRESS=
USDG_TOKEN_ADDRESS=
ORIEL_POOL_ADDRESS=
# v2 (getReserves) atau v3 (slot0) — sesuaikan dengan jenis pool Pons
POOL_TYPE=v2
# Isi bila token quote pool BUKAN stablecoin $1 (mis. WETH): harga quote dalam USD
QUOTE_USD_PRICE=1
# Wallet penerima pembayaran. Sangat disarankan multisig (Safe).
TREASURY_ADDRESS=
STAKING_CONTRACT_ADDRESS=
REVSHARE_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_ORIEL_TOKEN_ADDRESS=
NEXT_PUBLIC_USDG_TOKEN_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=

# --- Deploy kontrak (HANYA di mesin lokal, jangan di Vercel) ---
# PRIVATE_KEY=
# DISTRIBUTOR_OWNER=   # alamat multisig pemilik RevenueDistributor

# --- Ekonomi ---
TEMPLATE_ROYALTY_PCT=20        # [X]% royalti kreator dari nilai kredit template
REFERRAL_REWARD_PCT=10         # % kredit pembelian pertama untuk pengundang
REFERRAL_REWARD_MAX=500        # plafon kredit referral per undangan
STAKER_BUDGET_FLOOR_USD=0      # dana awal dari treasury untuk kredit staker saat margin masih nol

# --- Hosting & custom domain (Vercel) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_APEX_IPS=76.76.21.21

# --- Konektor OAuth ---
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=oriel
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32  (enkripsi token konektor AES-256-GCM — JANGAN diganti setelah ada data)
CONNECTOR_ENCRYPTION_KEY=
