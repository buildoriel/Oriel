# ======================================================================
# ORIEL — copy to .env.local (dev) and set in Vercel (production)
# NEXT_PUBLIC_* variables are visible in the browser. Everything else is a server secret.
# ======================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=https://buildoriel.com
NEXT_PUBLIC_ROOT_DOMAIN=buildoriel.com
SITES_CNAME_TARGET=sites.buildoriel.com
# Draft preview host (an origin separate from the app). Dev: http://preview.localhost:3000
PREVIEW_ORIGIN=https://preview.buildoriel.com
# openssl rand -base64 32
PREVIEW_SIGNING_SECRET=
# Used by Vercel Cron (Authorization: Bearer ... header). openssl rand -hex 32
CRON_SECRET=
# Shown on the Privacy and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=support@buildoriel.com
# Optional Discord invite link for the footer (hidden when empty)
NEXT_PUBLIC_DISCORD_URL=
# Salt for hashing reporter IPs on /report (openssl rand -hex 16). Falls back to PREVIEW_SIGNING_SECRET.
ABUSE_HASH_SALT=

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sign-in (Privy: wallet, email, Google) ---
# App id from dashboard.privy.io. Turn on "Return user data in an identity token" and allow https://buildoriel.com.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: the verification key (PEM) from the Privy dashboard; otherwise Privy's JWKS is used
PRIVY_VERIFICATION_KEY=

# --- Email notifications (Resend; leave empty to turn emails off) ---
RESEND_API_KEY=
EMAIL_FROM=Oriel <hello@buildoriel.com>

# --- AI provider ---
# openrouter (default) or anthropic
LLM_PROVIDER=openrouter
# openrouter.ai/keys
OPENROUTER_API_KEY=
# Providers allowed to serve the Claude models. Keep "anthropic" so the prompt cache hits.
OPENROUTER_PROVIDER_ORDER=anthropic
# Override model slugs if they differ on openrouter.ai/models, e.g.
# {"claude-sonnet-5-5":"anthropic/claude-sonnet-5.5"}
OPENROUTER_MODEL_MAP=
# Only needed when LLM_PROVIDER=anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override prices per 1M tokens, e.g.
# {"claude-sonnet-5-5":{"input":3,"output":15,"cacheWrite":3.75,"cacheRead":0.3}}
MODEL_PRICES_JSON=
# Raster images (photos/illustrations) via OpenRouter. Empty = the agent only uses SVG/CSS.
# Check the image model slug on openrouter.ai/models (e.g. google/gemini-2.5-flash-image)
IMAGE_MODEL=
# Estimated cost per image when OpenRouter does not return usage.cost
IMAGE_PRICE_USD=0.04
# Agent requests per user per hour (in addition to the one-running-build-per-user lock)
AGENT_RUNS_PER_HOUR=40
# Agent job queue: builds run in background slices, resumed until done (see lib/agent/jobs.ts)
AGENT_MAX_CONCURRENCY=25       # builds worked on at the same time across all users; the rest wait in the queue
AGENT_SLICE_SECONDS=150        # a worker stops starting new steps after this, saves state, and continues in a new invocation
# Base URL the queue uses to call its own worker (/api/jobs/work). Defaults to NEXT_PUBLIC_APP_URL.
JOBS_BASE_URL=
# Optional: Google Safe Browsing API key. Links in a project are checked before publish; known-bad links block it.
GOOGLE_SAFE_BROWSING_KEY=

# --- Robinhood Chain (mainnet, chain ID 4663) ---
# Server RPC containing the provider API key (Alchemy). Server only, never sent to the browser.
RH_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
RH_CHAIN_ID=4663
RH_EXPLORER_URL=https://robinhoodchain.blockscout.com
# RPC for browsers and user wallets: use the public endpoint, NEVER put an API-key URL here
# (every NEXT_PUBLIC_* value is visible to anyone who opens the site).
NEXT_PUBLIC_RH_CHAIN_ID=4663
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RH_EXPLORER_URL=https://robinhoodchain.blockscout.com
PAYMENT_MIN_CONFIRMATIONS=3

# Tokens & addresses (fill in after $ORIEL launches on Pons and the contracts are deployed)
ORIEL_TOKEN_ADDRESS=
USDG_TOKEN_ADDRESS=
ORIEL_POOL_ADDRESS=
# v2 (getReserves) or v3 (slot0) — match the Pons pool type
POOL_TYPE=v2
# Set when the pool's quote token is NOT a $1 stablecoin (e.g. WETH): quote price in USD
QUOTE_USD_PRICE=1
# Wallet that receives payments. A multisig (Safe) is strongly recommended.
TREASURY_ADDRESS=
STAKING_CONTRACT_ADDRESS=
REVSHARE_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_ORIEL_TOKEN_ADDRESS=
NEXT_PUBLIC_USDG_TOKEN_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=
# USDG decimals (for displaying revenue share & paying royalties). Check on the explorer.
NEXT_PUBLIC_USDG_DECIMALS=6

# --- Contract deployment (local machine ONLY, never on Vercel) ---
# PRIVATE_KEY=
# DISTRIBUTOR_OWNER=   # multisig address that owns RevenueDistributor

# --- Economics ---
TEMPLATE_ROYALTY_PCT=20        # [X]% creator royalty on a template's credit value
REFERRAL_REWARD_PCT=10         # % of the first purchase's credits given to the referrer
REFERRAL_REWARD_MAX=500        # referral credit cap per invite
STAKER_BUDGET_FLOOR_USD=0      # treasury seed funding for staker credits while margin is still zero
PAYOUT_MIN_USD=5               # creator royalties below this are held until the next period

# --- Hosting & custom domain (Vercel) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_APEX_IPS=76.76.21.21

# --- OAuth connectors ---
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Slug from the app's public link github.com/apps/<slug>; first-time users are sent to install it
GITHUB_APP_SLUG=
VERCEL_INTEGRATION_SLUG=oriel
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32  (AES-256-GCM connector token encryption — NEVER change once data exists)
CONNECTOR_ENCRYPTION_KEY=
